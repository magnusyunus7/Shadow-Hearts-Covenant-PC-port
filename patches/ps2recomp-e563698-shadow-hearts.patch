+        std::string rel = normalizeCdPathNoPrefix(ps2Path);
+        std::vector<std::string> parts;
+        for (size_t start = 0; start <= rel.size();)
+        {
+            size_t end = rel.find_first_of("/\\", start);
+            if (end == std::string::npos)
