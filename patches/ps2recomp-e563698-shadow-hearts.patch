diff --git a/ps2xIOP/src/emulator/core/iop_spu2.h b/ps2xIOP/src/emulator/core/iop_spu2.h
new file mode 100644
index 0000000000000000000000000000000000000000..90c84442b24c18b7327962cb0c96c81399194637
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/iop_spu2.h
@@ -0,0 +1,528 @@
+#pragma once
+
+// Minimal SPU2 (PS2 sound processor) for the IOP emulator.
+//
+// Written from the public register documentation (PSX SPU description in "psx-spx" and the PS2
+// SPU2 register layout), not from another emulator's code. Covers what Shadow Hearts' sound
+// driver (LIBSD.IRX + SDRV_IOP.IRX) uses: 2 MB sound RAM filled by block DMA or the data port,
+// 2 cores x 24 voices with PS-ADPCM decoding, pitch, ADSR envelopes, fixed volumes, key on/off,
+// loop flags and ENDX, and a dry stereo mix. Not yet: reverb, noise, pitch modulation, volume
+// sweeps, SPU2 interrupts, AutoDMA.
+//
+// Registers arrive from the IOP thread (write16/read16); audio is pulled from the host audio
+// thread (mix). One mutex guards the whole state.
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t RamWords = 1024u * 1024u; // 2 MB as 16-bit words
+        static constexpr uint32_t VoicesPerCore = 24u;
+
+        Spu2() : m_ram(RamWords, 0u) { reset(); }
+
+        void reset()
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            std::fill(m_ram.begin(), m_ram.end(), 0u);
+            m_regs.fill(0u);
+            for (Core &c : m_cores)
+                c = Core{};
+            std::fill(m_ring.begin(), m_ring.end(), int16_t{0});
+            m_ringRead = m_ringWrite = 0u;
+            m_cycleAcc = 0u;
+        }
+
+        // ---- register interface (offset = address - 0x1F900000) -------------------------------
+
+        void write16(uint32_t offset, uint16_t value)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            offset &= 0x7FEu;
+            m_regs[offset / 2u] = value;
+
+            const uint32_t coreIndex = coreOf(offset);
+            if (coreIndex > 1u)
+                return; // 0x760.. volume block: handled below via m_regs
+            Core &core = m_cores[coreIndex];
+            const uint32_t local = offset - coreIndex * 0x400u;
+
+            if (local < 0x180u)
+            {
+                Voice &v = core.voices[local / 0x10u];
+                switch (local & 0xFu)
+                {
+                case 0x0: v.volL = value; break;
+                case 0x2: v.volR = value; break;
+                case 0x4: v.pitch = value; break;
+                case 0x6: v.adsr1 = value; break;
+                case 0x8: v.adsr2 = value; break;
+                case 0xA: v.envelope = static_cast<int32_t>(value & 0x7FFFu); break;
+                default: break;
+                }
+                return;
+            }
+            if (local >= 0x1C0u && local < 0x1C0u + VoicesPerCore * 0xCu)
+            {
+                Voice &v = core.voices[(local - 0x1C0u) / 0xCu];
+                switch ((local - 0x1C0u) % 0xCu)
+                {
+                case 0x0: v.ssa = (v.ssa & 0xFFFFu) | ((value & 0xFu) << 16); break;
+                case 0x2: v.ssa = (v.ssa & 0xF0000u) | value; break;
+                case 0x4: v.lsa = (v.lsa & 0xFFFFu) | ((value & 0xFu) << 16); v.lsaWritten = true; break;
+                case 0x6: v.lsa = (v.lsa & 0xF0000u) | value; v.lsaWritten = true; break;
+                case 0x8: v.nax = (v.nax & 0xFFFFu) | ((value & 0xFu) << 16); break;
+                case 0xA: v.nax = (v.nax & 0xF0000u) | value; break;
+                default: break;
+                }
+                return;
+            }
+            switch (local)
+            {
+            case 0x188: core.vmixL = (core.vmixL & 0xFF0000u) | value; break;
+            case 0x18A: core.vmixL = (core.vmixL & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+            case 0x190: core.vmixR = (core.vmixR & 0xFF0000u) | value; break;
+            case 0x192: core.vmixR = (core.vmixR & 0xFFFFu) | ((value & 0xFFu) << 16); break;
+            case 0x1A0: keyOn(core, value, 0u); break;
+            case 0x1A2: keyOn(core, value & 0xFFu, 16u); break;
+            case 0x1A4: keyOff(core, value, 0u); break;
+            case 0x1A6: keyOff(core, value & 0xFFu, 16u); break;
+            case 0x1A8: core.tsa = (core.tsa & 0xFFFFu) | ((value & 0xFu) << 16); break;
+            case 0x1AA: core.tsa = (core.tsa & 0xF0000u) | value; break;
+            case 0x1AC: // data port: one 16-bit word into sound RAM at TSA
+                m_ram[core.tsa & (RamWords - 1u)] = value;
+                core.tsa = (core.tsa + 1u) & (RamWords - 1u);
+                break;
+            case 0x340: core.endx &= 0xFF0000u; break; // a write clears the ENDX flags
+            case 0x342: core.endx &= 0x00FFFFu; break;
+            default: break;
+            }
+        }
+
+        // Returns true and the live value for registers the SPU2 computes; false otherwise
+        // (the caller then returns the last written value).
+        bool read16(uint32_t offset, uint16_t &out)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            offset &= 0x7FEu;
+            const uint32_t coreIndex = coreOf(offset);
+            if (coreIndex > 1u)
+                return false;
+            Core &core = m_cores[coreIndex];
+            const uint32_t local = offset - coreIndex * 0x400u;
+            if (local < 0x180u)
+            {
+                const Voice &v = core.voices[local / 0x10u];
+                if ((local & 0xFu) == 0xA)
+                {
+                    out = static_cast<uint16_t>(v.envelope);
+                    return true;
+                }
+                return false;
+            }
+            if (local >= 0x1C0u && local < 0x1C0u + VoicesPerCore * 0xCu)
+            {
+                const Voice &v = core.voices[(local - 0x1C0u) / 0xCu];
+                switch ((local - 0x1C0u) % 0xCu)
+                {
+                case 0x8: out = static_cast<uint16_t>((v.addr >> 16) & 0xFu); return true;
+                case 0xA: out = static_cast<uint16_t>(v.addr & 0xFFFFu); return true;
+                default: return false;
+                }
+            }
+            switch (local)
+            {
+            case 0x1A8: out = static_cast<uint16_t>((core.tsa >> 16) & 0xFu); return true;
+            case 0x1AA: out = static_cast<uint16_t>(core.tsa & 0xFFFFu); return true;
+            case 0x340: out = static_cast<uint16_t>(core.endx & 0xFFFFu); return true;
+            case 0x342: out = static_cast<uint16_t>((core.endx >> 16) & 0xFFu); return true;
+            default: return false;
+            }
+        }
+
+        // Block DMA from IOP RAM into sound RAM at the core's TSA (bytes must be even).
+        void dmaWrite(uint32_t coreIndex, const uint8_t *src, uint32_t bytes)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            Core &core = m_cores[coreIndex & 1u];
+            for (uint32_t i = 0; i + 1u < bytes; i += 2u)
+            {
+                m_ram[core.tsa & (RamWords - 1u)] = static_cast<uint16_t>(src[i] | (src[i + 1u] << 8));
+                core.tsa = (core.tsa + 1u) & (RamWords - 1u);
+            }
+        }
+
+        // ---- audio output (host audio thread) ------------------------------------------------
+
+        // Emulated time: called with the EE cycles the emulator just ran. Produces 48 kHz
+        // frames at the emulated rate into a buffer that the host audio thread drains, so when
+        // the game runs slower than real time the sound gaps instead of looping stale stream
+        // data.
+        void advanceEeCycles(uint64_t eeCycles)
+        {
+            constexpr uint64_t kEeClock = 294912000ull;
+            if (m_realtime)
+                return;
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_cycleAcc += eeCycles * 48000ull;
+            uint64_t frames = m_cycleAcc / kEeClock;
+            m_cycleAcc %= kEeClock;
+            while (frames > 0u)
+            {
+                const uint32_t n = static_cast<uint32_t>(std::min<uint64_t>(frames, 256u));
+                int16_t tmp[512];
+                render(tmp, n);
+                for (uint32_t i = 0; i < n * 2u; ++i)
+                {
+                    m_ring[m_ringWrite] = tmp[i];
+                    m_ringWrite = (m_ringWrite + 1u) % kRingSamples;
+                    if (m_ringWrite == m_ringRead) // full: drop the oldest frame
+                        m_ringRead = (m_ringRead + 2u) % kRingSamples;
+                }
+                frames -= n;
+            }
+        }
+
+        // Host audio thread: fills `frames` interleaved stereo 16-bit frames at 48 kHz from
+        // what the emulated SPU2 has produced; silence (fading from the last sample) if it is
+        // behind.
+        void mix(int16_t *out, uint32_t frames)
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            if (m_realtime)
+            {
+                // PS2X_SPU2_REALTIME=1: voices advance in real time (correct pitch and tempo
+                // of what is already in sound RAM, but streamed speech/music repeats when the
+                // game is too slow to refill its buffers).
+                render(out, frames);
+                return;
+            }
+            // Keep latency bounded (~0.2 s) if the emulator ran ahead.
+            const uint32_t buffered = (m_ringWrite + kRingSamples - m_ringRead) % kRingSamples;
+            if (buffered > 9600u * 2u)
+                m_ringRead = (m_ringWrite + kRingSamples - 4800u * 2u) % kRingSamples;
+            for (uint32_t f = 0; f < frames; ++f)
+            {
+                for (uint32_t ch = 0; ch < 2u; ++ch)
+                {
+                    if (m_ringRead != m_ringWrite)
+                    {
+                        m_last[ch] = m_ring[m_ringRead];
+                        m_ringRead = (m_ringRead + 1u) % kRingSamples;
+                    }
+                    else
+                    {
+                        m_last[ch] = static_cast<int16_t>(m_last[ch] * 31 / 32);
+                    }
+                    out[f * 2u + ch] = m_last[ch];
+                }
+            }
+        }
+
+    private:
+        // Renders `frames` stereo frames from the current voice state (lock held).
+        void render(int16_t *out, uint32_t frames)
+        {
+            const int32_t masterL = volume(m_regs[0x788u / 2u]); // core 1 MVOLL (final output)
+            const int32_t masterR = volume(m_regs[0x78Au / 2u]);
+            const int32_t core0L = volume(m_regs[0x760u / 2u]);  // core 0 MVOLL
+            const int32_t core0R = volume(m_regs[0x762u / 2u]);
+            for (uint32_t f = 0; f < frames; ++f)
+            {
+                int32_t mixL[2] = {0, 0}, mixR[2] = {0, 0};
+                for (uint32_t c = 0; c < 2u; ++c)
+                {
+                    Core &core = m_cores[c];
+                    for (uint32_t i = 0; i < VoicesPerCore; ++i)
+                    {
+                        Voice &v = core.voices[i];
+                        if (v.phase == Phase::Off)
+                            continue;
+                        const int32_t s = voiceSample(core, v, i);
+                        if (core.vmixL & (1u << i))
+                            mixL[c] += (s * volume(v.volL)) >> 15;
+                        if (core.vmixR & (1u << i))
+                            mixR[c] += (s * volume(v.volR)) >> 15;
+                    }
+                }
+                // Core 0 feeds core 1 on the PS2; both end up in the final output here.
+                int32_t l = ((mixL[0] * core0L) >> 15) + mixL[1];
+                int32_t r = ((mixR[0] * core0R) >> 15) + mixR[1];
+                l = (l * masterL) >> 15;
+                r = (r * masterR) >> 15;
+                out[f * 2u] = static_cast<int16_t>(std::clamp(l, -32768, 32767));
+                out[f * 2u + 1u] = static_cast<int16_t>(std::clamp(r, -32768, 32767));
+            }
+        }
+
+        enum class Phase : uint8_t { Off, Attack, Decay, Sustain, Release };
+
+        struct Voice
+        {
+            uint16_t volL = 0, volR = 0, pitch = 0, adsr1 = 0, adsr2 = 0;
+            uint32_t ssa = 0, lsa = 0, nax = 0;
+            bool lsaWritten = false;
+            uint32_t addr = 0;      // current block (16-bit word address, 8 words per block)
+            uint32_t counter = 0;   // 4.12 position inside the decoded block
+            int32_t decoded[28] = {};
+            uint32_t decodedIndex = 28;
+            int32_t hist1 = 0, hist2 = 0;
+            int32_t prevSample = 0;
+            int32_t envelope = 0;
+            uint32_t envWait = 0;
+            Phase phase = Phase::Off;
+        };
+
+        struct Core
+        {
+            std::array<Voice, VoicesPerCore> voices{};
+            uint32_t vmixL = 0, vmixR = 0;
+            uint32_t tsa = 0;
+            uint32_t endx = 0;
+        };
+
+        static uint32_t coreOf(uint32_t offset)
+        {
+            if (offset < 0x400u)
+                return 0u;
+            if (offset < 0x760u)
+                return offset < 0x400u + 0x360u ? 1u : 2u;
+            return 2u;
+        }
+
+        // Fixed volume: bits 0-14 are volume/2 as a signed 15-bit value. Sweep mode (bit 15)
+        // is not emulated yet: such voices play at their last fixed level, or full if none.
+        static int32_t volume(uint16_t reg)
+        {
+            if (reg & 0x8000u)
+                return 0x7FFF;
+            int32_t v = reg & 0x7FFF;
+            if (v & 0x4000)
+                v -= 0x8000;
+            return std::clamp(v * 2, -0x8000, 0x7FFF);
+        }
+
+        void keyOn(Core &core, uint32_t mask, uint32_t first)
+        {
+            for (uint32_t i = 0; i < 16u && first + i < VoicesPerCore; ++i)
+            {
+                if (!(mask & (1u << i)))
+                    continue;
+                Voice &v = core.voices[first + i];
+                if (m_diag && m_konLogs < 400u)
+                {
+                    ++m_konLogs;
+                    std::fprintf(stderr, "[spu2:voice] core=%u v=%u ssa=%05x pitch=%04x vol=%04x/%04x adsr=%04x/%04x\n",
+                                 static_cast<unsigned>(&core - m_cores.data()), first + i, v.ssa, v.pitch, v.volL, v.volR,
+                                 v.adsr1, v.adsr2);
+                }
+                v.addr = v.ssa;
+                v.counter = 0;
+                v.decodedIndex = 28;
+                v.hist1 = v.hist2 = 0;
+                v.prevSample = 0;
+                v.envelope = 0;
+                v.envWait = 0;
+                v.lsaWritten = false;
+                v.phase = Phase::Attack;
+                core.endx &= ~(1u << (first + i));
+            }
+        }
+
+        void keyOff(Core &core, uint32_t mask, uint32_t first)
+        {
+            for (uint32_t i = 0; i < 16u && first + i < VoicesPerCore; ++i)
+            {
+                if (!(mask & (1u << i)))
+                    continue;
+                Voice &v = core.voices[first + i];
+                if (v.phase != Phase::Off)
+                {
+                    v.phase = Phase::Release;
+                    v.envWait = 0;
+                }
+            }
+        }
+
+        // Decodes the PS-ADPCM block at v.addr (8 words = 16 bytes = 28 samples) and handles
+        // its loop flags. Returns false if the voice ended.
+        bool decodeBlock(Core &core, Voice &v, uint32_t voiceIndex)
+        {
+            static constexpr int32_t kFilter[5][2] = {{0, 0}, {60, 0}, {115, -52}, {98, -55}, {122, -60}};
+            const uint32_t base = v.addr & (RamWords - 1u) & ~7u;
+            const uint16_t w0 = m_ram[base];
+            const uint32_t shift = w0 & 0xFu;
+            const uint32_t filter = std::min<uint32_t>((w0 >> 4) & 0x7u, 4u);
+            const uint32_t flags = (w0 >> 8) & 0xFFu;
+            if (flags & 0x4u)
+            {
+                if (!v.lsaWritten)
+                    v.lsa = base; // loop start flag
+            }
+            const int32_t f0 = kFilter[filter][0], f1 = kFilter[filter][1];
+            for (uint32_t n = 0; n < 28u; ++n)
+            {
+                const uint16_t w = m_ram[(base + 1u + n / 4u) & (RamWords - 1u)];
+                int32_t nib = (w >> ((n & 3u) * 4u)) & 0xF;
+                if (nib & 0x8)
+                    nib -= 16;
+                int32_t s = (nib << 12) >> (shift > 12 ? 9 : shift);
+                s += (v.hist1 * f0 + v.hist2 * f1 + 32) >> 6;
+                s = std::clamp(s, -32768, 32767);
+                v.hist2 = v.hist1;
+                v.hist1 = s;
+                v.decoded[n] = s;
+            }
+            v.decodedIndex = 0;
+
+            if (flags & 0x1u) // loop end
+            {
+                core.endx |= 1u << voiceIndex;
+                if (flags & 0x2u)
+                {
+                    v.addr = v.lsa; // repeat
+                }
+                else
+                {
+                    v.addr = v.lsa;
+                    v.phase = Phase::Release;
+                    v.envelope = 0; // end without repeat: silence the voice
+                    v.phase = Phase::Off;
+                    return true;
+                }
+            }
+            else
+            {
+                v.addr = (base + 8u) & (RamWords - 1u);
+            }
+            return true;
+        }
+
+        int32_t voiceSample(Core &core, Voice &v, uint32_t voiceIndex)
+        {
+            // Advance the sample position by the pitch (0x1000 = 48 kHz).
+            if (v.decodedIndex >= 28u)
+                decodeBlock(core, v, voiceIndex);
+            if (v.phase == Phase::Off)
+                return 0;
+            const int32_t cur = v.decoded[std::min<uint32_t>(v.decodedIndex, 27u)];
+            const int32_t frac = static_cast<int32_t>(v.counter & 0xFFFu);
+            const int32_t sample = v.prevSample + (((cur - v.prevSample) * frac) >> 12);
+
+            v.counter += std::min<uint32_t>(v.pitch, 0x3FFFu);
+            while (v.counter >= 0x1000u)
+            {
+                v.counter -= 0x1000u;
+                v.prevSample = v.decoded[std::min<uint32_t>(v.decodedIndex, 27u)];
+                if (++v.decodedIndex >= 28u)
+                {
+                    decodeBlock(core, v, voiceIndex);
+                    if (v.phase == Phase::Off)
+                        return 0;
+                }
+            }
+
+            stepEnvelope(v);
+            return (sample * v.envelope) >> 15;
+        }
+
+        // ADSR, following the documented envelope rule: every 2^max(0, shift-11) samples the
+        // level changes by step << max(0, 11-shift); exponential increase above 0x6000 is 4x
+        // slower; exponential decrease scales the step by level/0x8000.
+        void envelopeTick(Voice &v, bool exponential, bool decrease, uint32_t shift, int32_t step)
+        {
+            uint32_t cycles = 1u << (shift > 11u ? shift - 11u : 0u);
+            int32_t delta = step << (shift < 11u ? 11u - shift : 0u);
+            if (exponential && !decrease && v.envelope > 0x6000)
+                cycles *= 4u;
+            if (exponential && decrease)
+                delta = (delta * v.envelope) >> 15;
+            if (++v.envWait < cycles)
+                return;
+            v.envWait = 0;
+            v.envelope = std::clamp(v.envelope + delta, 0, 0x7FFF);
+        }
+
+        void stepEnvelope(Voice &v)
+        {
+            switch (v.phase)
+            {
+            case Phase::Attack:
+            {
+                const bool exp = (v.adsr1 & 0x8000u) != 0u;
+                const uint32_t shift = (v.adsr1 >> 10) & 0x1Fu;
+                const int32_t step = 7 - static_cast<int32_t>((v.adsr1 >> 8) & 3u);
+                envelopeTick(v, exp, false, shift, step);
+                if (v.envelope >= 0x7FFF)
+                {
+                    v.phase = Phase::Decay;
+                    v.envWait = 0;
+                }
+                break;
+            }
+            case Phase::Decay:
+            {
+                const uint32_t shift = (v.adsr1 >> 4) & 0xFu;
+                envelopeTick(v, true, true, shift, -8);
+                const int32_t sustainLevel = static_cast<int32_t>(((v.adsr1 & 0xFu) + 1u) * 0x800u);
+                if (v.envelope <= sustainLevel)
+                {
+                    v.phase = Phase::Sustain;
+                    v.envWait = 0;
+                }
+                break;
+            }
+            case Phase::Sustain:
+            {
+                const bool exp = (v.adsr2 & 0x8000u) != 0u;
+                const bool dec = (v.adsr2 & 0x4000u) != 0u;
+                const uint32_t shift = (v.adsr2 >> 8) & 0x1Fu;
+                const int32_t raw = static_cast<int32_t>((v.adsr2 >> 6) & 3u);
+                envelopeTick(v, exp, dec, shift, dec ? (-8 + raw) : (7 - raw));
+                break;
+            }
+            case Phase::Release:
+            {
+                const bool exp = (v.adsr2 & 0x20u) != 0u;
+                const uint32_t shift = v.adsr2 & 0x1Fu;
+                envelopeTick(v, exp, true, shift, -8);
+                if (v.envelope <= 0)
+                    v.phase = Phase::Off;
+                break;
+            }
+            default:
+                break;
+            }
+        }
+
+        static constexpr uint32_t kRingSamples = 48000u * 2u; // 1 s of stereo
+        std::mutex m_mutex;
+        std::vector<int16_t> m_ring = std::vector<int16_t>(kRingSamples, 0);
+        uint32_t m_ringRead = 0u, m_ringWrite = 0u;
+        int16_t m_last[2] = {0, 0};
+        uint64_t m_cycleAcc = 0u;
+        std::vector<uint16_t> m_ram;
+        std::array<uint16_t, 0x800u / 2u> m_regs{};
+        std::array<Core, 2> m_cores{};
+        bool m_diag = std::getenv("PS2X_SPU2DIAG") != nullptr;
+        bool m_realtime = std::getenv("PS2X_SPU2_REALTIME") != nullptr;
+        uint32_t m_konLogs = 0u;
+    };
+
+    // The one SPU2 of the emulated IOP.
+    inline Spu2 &spu2()
+    {
+        static Spu2 instance;
+        return instance;
+    }
+}
