+    struct Spu2Diag
+    {
+        bool enabled = std::getenv("PS2X_SPU2DIAG") != nullptr;
+        std::array<uint32_t, 0x800 / 2> counts{};
+        uint64_t total = 0u;
+        uint32_t summaries = 0u;
+        uint32_t konLogs = 0u;
