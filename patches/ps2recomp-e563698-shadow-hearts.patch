@@ -0,0 +1,30 @@
+#pragma once
+// Opt-in SIF/IOP diagnostics. Enable by setting the environment variable PS2X_SIFDIAG=1.
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+
+namespace ps2x::iop
+{
+    inline bool sifDiagEnabled() noexcept
+    {
+        static const bool enabled = [] {
+            const char *v = std::getenv("PS2X_SIFDIAG");
+            return v && *v && *v != '0';
+        }();
+        return enabled;
+    }
+
+    inline void sifDiag(const char *fmt, ...) noexcept
+    {
+        if (!sifDiagEnabled())
+            return;
+        std::va_list args;
+        va_start(args, fmt);
+        std::fputs("[sifdiag] ", stderr);
+        std::vfprintf(stderr, fmt, args);
+        std::fputc('\n', stderr);
+        std::fflush(stderr);
+        va_end(args);
+    }
+}
