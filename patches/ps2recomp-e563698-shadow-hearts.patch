+                    marked.dispfb1 = m_markRegs[2];
+                    marked.display1 = m_markRegs[3];
+                    marked.dispfb2 = m_markRegs[4];
+                    marked.display2 = m_markRegs[5];
+                    marked.bgcolor = m_markRegs[6];
+                    marked.refreshUnderLock = nullptr;
+                    marked.refreshUser = nullptr;
+                    if (!m_presentBackendReady)
+                    {
+                        m_presentBackend.Initialize(m_markVram.data(), static_cast<uint32_t>(m_markVram.size()));
+                        m_presentBackendReady = true;
+                    }
+                    return m_presentBackend.Present(marked);
+                }
+            }
+            // Sample the display registers first, then wait for every draw
+            // submitted up to now. The buffer they point at was finished
+            // (in submission order) before the guest flipped to it, so it is
+            // complete after the drain, even if the guest flips again
+            // meanwhile. Re-reading the registers after the drain (what the
+            // synchronous backend does under its lock) could pick up a newer
+            // flip whose drawing is still queued.
+            GSPresentationRequest sampled = request;
+            if (sampled.refreshUnderLock)
+            {
+                sampled.refreshUnderLock(sampled.refreshUser, sampled);
+                sampled.refreshUnderLock = nullptr;
+                sampled.refreshUser = nullptr;
+            }
+            drain();
+            return m_inner->Present(sampled);
+        }
+
+        bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override
+        {
+            drain();
+            return m_inner->ClearFramebuffer(context, rgba);
+        }
+        uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override
+        {
+            drain();
+            return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+        }
+
+        uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override
+        {
+            drain();
+            return m_inner->ReadVram(psm, base, bw, x, y);
+        }
+        void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override
+        {
+            Command c;
+            c.kind = Kind::WriteVram;
+            c.psm = psm;
+            c.base = base;
+            c.bw = bw;
+            c.x = x;
+            c.y = y;
+            c.value = value;
+            push(std::move(c));
+        }
+        void SnapshotVram(std::vector<uint8_t> &out) const override
+        {
+            drain();
+            m_inner->SnapshotVram(out);
+        }
+        GSTransferSnapshot GetTransferSnapshot() const override
+        {
+            return m_inner->GetTransferSnapshot();
+        }
+
+    private:
+        enum class Kind : uint8_t
+        {
+            Submit,
+            LoadClut,
+            BeginTransfer,
+            UploadImage,
+            TextureFlush,
+            WriteVram,
+            VsyncMark
+        };
+        struct Command
+        {
+            Kind kind = Kind::Submit;
+            GSPrimitiveBatch batch{};
+            GSTex0Reg tex0{};
+            GSTexClutReg texclut{};
+            GSTransferCommand transfer{};
+            std::vector<uint8_t> data;
+            uint32_t psm = 0, base = 0, bw = 0, x = 0, y = 0, value = 0;
+            uint64_t regs[7]{};
+        };
+
+        // Bounded queue: the producer waits when the worker is this far behind.
+        // Kept short: Present() on the window thread waits for everything
+        // queued, and a deep queue (16384 at first) froze the window for
+        // seconds ("not responding"). PS2X_GS_QUEUE overrides it.
+        static size_t maxQueued()
+        {
+            static const size_t n = []
+            {
+                const char *v = std::getenv("PS2X_GS_QUEUE");
+                if (v && *v)
+                {
+                    const unsigned long long q = std::strtoull(v, nullptr, 0);
+                    return static_cast<size_t>(q < 16ull ? 16ull : q);
+                }
+                return static_cast<size_t>(256u);
+            }();
+            return n;
+        }
+
+        void push(Command &&c)
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_spaceCv.wait(lock, [this] { return m_queue.size() < maxQueued(); });
+            m_queue.push_back(std::move(c));
+            ++m_submitted;
+            if (m_queue.size() == 1u)
+                m_workCv.notify_one();
+        }
+
+        void drain() const
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            const uint64_t target = m_submitted;
+            m_doneCv.wait(lock, [this, target] { return m_completed >= target; });
+        }
+
+        void takeVsyncSnapshot(const Command &c)
+        {
+            if (!markPresentEnabled() || !m_cpu)
+                return;
+            std::lock_guard<std::mutex> rasterLock(m_cpu->RasterMutex());
+            std::lock_guard<std::mutex> lock(m_markMutex);
+            if (!m_vram || m_vramSize == 0u)
+                return;
+            if (m_markVram.size() != m_vramSize)
+            {
+                m_markVram.assign(m_vramSize, 0u);
+                m_presentBackendReady = false;
+            }
+            std::memcpy(m_markVram.data(), m_vram, m_vramSize);
+            std::copy(std::begin(c.regs), std::end(c.regs), std::begin(m_markRegs));
+            m_hasMark = true;
+        }
+
+        void execute(Command &c)
+        {
+            switch (c.kind)
+            {
+            case Kind::Submit:
+                m_inner->Submit(c.batch);
+                break;
+            case Kind::LoadClut:
+                m_inner->LoadClut(c.tex0, c.texclut);
+                break;
+            case Kind::BeginTransfer:
+                m_inner->BeginTransfer(c.transfer);
+                break;
+            case Kind::UploadImage:
+                m_inner->UploadImage(c.data.empty() ? nullptr : c.data.data(), static_cast<uint32_t>(c.data.size()));
+                break;
+            case Kind::TextureFlush:
+                m_inner->TextureFlush();
+                break;
+            case Kind::WriteVram:
+                m_inner->WriteVram(c.psm, c.base, c.bw, c.x, c.y, c.value);
+                break;
+            case Kind::VsyncMark:
+                takeVsyncSnapshot(c);
+                break;
+            }
+        }
+
+        // ---- parallel rasterisation -------------------------------------
+        // Consecutive draws are split across PS2X_GS_WORKERS threads by 16-row
+        // screen bands; each thread runs the draws in submission order, so
+        // every pixel sees the same sequence of writes as on one thread. A run
+        // of draws ends (all threads join) before any non-draw command, when
+        // the render target (FRAME/ZBUF) changes, and before a draw whose
+        // texture pages may have been drawn to earlier in the run, so
+        // render-to-texture always reads finished data. Each thread has its
+        // own texture page cache, invalidated at the start of every run.
+        static uint32_t workerCount()
+        {
+            static const uint32_t n = []
+            {
+                if (const char *v = std::getenv("PS2X_GS_WORKERS"); v && *v)
+                {
+                    const unsigned long n = std::strtoul(v, nullptr, 0);
+                    return static_cast<uint32_t>(std::clamp<unsigned long>(n, 1ul, 16ul));
+                }
+                const unsigned hw = std::thread::hardware_concurrency();
+                // Leave room for the game thread and the window thread.
+                return static_cast<uint32_t>(std::clamp<int>(static_cast<int>(hw) - 2, 1, 4));
+            }();
+            return n;
+        }
+
+        struct PagePlan
+        {
+            std::bitset<512> dirty;   // 8 KB VRAM pages drawn to in the current run (any format)
+            std::bitset<512> dirty32; // ... of those, pages written with all 32 bits (not CT24/Z24)
+            bool hasTarget = false;
+            uint64_t frameKey = 0;
+            uint64_t zbufKey = 0;
+        };
+
+        static void markPages(std::bitset<512> &set, uint32_t firstPage, uint32_t count)
+        {
+            count = std::min<uint32_t>(count, 512u);
+            for (uint32_t i = 0; i < count; ++i)
+                set.set((firstPage + i) & 511u);
+        }
+        static bool anyPages(const std::bitset<512> &set, uint32_t firstPage, uint32_t count)
+        {
+            count = std::min<uint32_t>(count, 512u);
+            for (uint32_t i = 0; i < count; ++i)
+                if (set.test((firstPage + i) & 511u))
+                    return true;
+            return false;
+        }
+
+        // Page size (pixels) of a pixel storage format: 8 KB pages of
+        // 64x32 (32-bit and the H formats, which live in 32-bit pages), 64x64
+        // (16-bit), 128x64 (8-bit) and 128x128 (4-bit).
+        static void pageSize(uint32_t psm, uint32_t &w, uint32_t &h)
+        {
+            switch (psm)
+            {
+            case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S:
+                w = 64u; h = 64u; break;
+            case GS_PSM_T8:
+                w = 128u; h = 64u; break;
+            case GS_PSM_T4:
+                w = 128u; h = 128u; break;
+            default:
+                w = 64u; h = 32u; break;
+            }
+        }
+
+        // The Z buffer is read for ZTST GEQUAL/GREATER and written unless ZMSK
+        // (same conditions as GSCpuBackend::WritePixel). Otherwise its memory is
+        // untouched, and games often keep textures there.
+        static bool touchesZ(const GSContext &ctx)
+        {
+            const uint32_t ztst = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+            return !ctx.zbuf.zmask || ztst >= 2u;
+        }
+
+        // Pages covered by rows 0..lastRow of a buffer bw*64 pixels wide
+        // starting on a page boundary (FBP/ZBP are page addresses; texture
+        // callers add a page for block-aligned TBP0).
+        static uint32_t bufferPageCount(uint32_t psm, uint32_t bw, uint32_t lastRow)
+        {
+            uint32_t pw = 64u, ph = 32u;
+            pageSize(psm, pw, ph);
+            const uint32_t widthPx = std::max<uint32_t>(bw, 1u) * 64u;
+            const uint32_t pagesWide = (widthPx + pw - 1u) / pw;
+            return pagesWide * (lastRow / ph + 1u);
+        }
+
+        // Non-zero if this draw must not join the current run:
+        // 1 = its render target overlaps memory drawn in the run, 2 = its texture does.
+        static int needsJoin(const PagePlan &plan, const GSPrimitiveBatch &b)
+        {
+            const auto &ctx = b.state.context;
+            const uint64_t frameKey = (static_cast<uint64_t>(ctx.frame.fbp) << 24) | (static_cast<uint64_t>(ctx.frame.fbw) << 8) | ctx.frame.psm;
+            const uint64_t zbufKey = (static_cast<uint64_t>(ctx.zbuf.zbp) << 8) | ctx.zbuf.psm;
+            if (plan.hasTarget && (frameKey != plan.frameKey || zbufKey != plan.zbufKey))
+            {
+                // A different render target can join the run when its memory
+                // is disjoint from everything drawn in the run so far.
+                const uint32_t lastRow = static_cast<uint32_t>(std::max<int>(ctx.scissor.y1, 0));
+                if (anyPages(plan.dirty, ctx.frame.fbp, bufferPageCount(ctx.frame.psm, ctx.frame.fbw, lastRow)) ||
+                    (touchesZ(ctx) && anyPages(plan.dirty, ctx.zbuf.zbp, bufferPageCount(ctx.zbuf.psm, ctx.frame.fbw, lastRow))))
+                    return 1;
+            }
+            if (b.state.prim.tme)
+            {
+                const auto &tex = ctx.tex0;
+                const uint64_t clamp = ctx.clamp;
+                uint32_t height = 1u << std::min<uint32_t>(tex.th, 10u);
+                const uint32_t wrapV = static_cast<uint32_t>((clamp >> 2) & 3u);
+                const uint32_t minV = static_cast<uint32_t>((clamp >> 24) & 0x3FFu);
+                const uint32_t maxV = static_cast<uint32_t>((clamp >> 34) & 0x3FFu);
+                if (wrapV == 2u)
+                    height = std::max(height, maxV + 1u);
+                else if (wrapV == 3u)
+                    height = std::max(height, (minV | maxV) + 1u);
+                const uint32_t width = 1u << std::min<uint32_t>(tex.tw, 10u);
+                const uint32_t bw = std::max<uint32_t>(tex.tbw, (width + 63u) / 64u);
+                // tbp0 is in 256-byte blocks (32 per page) and need not be page aligned.
+                const uint32_t count = bufferPageCount(tex.psm, bw, height - 1u) + 1u;
+                // T8H/T4HL/T4HH textures read only bits 24..31 of 32-bit pages.
+                // CT24/Z24 targets never change those bits (RMW keeps the top
+                // byte, as on the GS), so only fully written pages conflict.
+                // Games keep 8-bit textures in the alpha byte of a 24-bit frame
+                // buffer this way.
+                const bool highBitsOnly = tex.psm == GS_PSM_T8H || tex.psm == GS_PSM_T4HL || tex.psm == GS_PSM_T4HH;
+                if (anyPages(highBitsOnly ? plan.dirty32 : plan.dirty, static_cast<uint32_t>(tex.tbp0) >> 5, count))
+                    return 2;
+            }
+            return 0;
+        }
+
+        // CLUT source pages (CBP is a block address; CSM2 reads row COV).
+        static bool clutSourceDirty(const PagePlan &plan, const Command &c)
+        {
+            uint32_t count = 2u;
+            if (c.tex0.csm != 0u)
+                count = bufferPageCount(c.tex0.cpsm, std::max<uint32_t>(c.texclut.cbw, 1u), c.texclut.cov) + 1u;
+            return anyPages(plan.dirty, static_cast<uint32_t>(c.tex0.cbp) >> 5, count);
+        }
+
+        static void addToPlan(PagePlan &plan, const GSPrimitiveBatch &b)
+        {
+            const auto &ctx = b.state.context;
+            plan.hasTarget = true;
+            plan.frameKey = (static_cast<uint64_t>(ctx.frame.fbp) << 24) | (static_cast<uint64_t>(ctx.frame.fbw) << 8) | ctx.frame.psm;
+            plan.zbufKey = (static_cast<uint64_t>(ctx.zbuf.zbp) << 8) | ctx.zbuf.psm;
+            const uint32_t lastRow = static_cast<uint32_t>(std::max<int>(ctx.scissor.y1, 0));
+            const uint32_t framePages = bufferPageCount(ctx.frame.psm, ctx.frame.fbw, lastRow);
+            markPages(plan.dirty, ctx.frame.fbp, framePages);
+            if (ctx.frame.psm != GS_PSM_CT24)
+                markPages(plan.dirty32, ctx.frame.fbp, framePages);
+            if (touchesZ(ctx))
+            {
+                const uint32_t zPages = bufferPageCount(ctx.zbuf.psm, ctx.frame.fbw, lastRow);
+                markPages(plan.dirty, ctx.zbuf.zbp, zPages);
+                if (ctx.zbuf.psm != GS_PSM_Z24)
+                    markPages(plan.dirty32, ctx.zbuf.zbp, zPages);
+            }
+        }
+
+        // A draw that samples from its own render target: rows drawn by other
+        // threads could be read mid-draw, so it is drawn on one thread.
+        static bool samplesOwnTarget(const GSPrimitiveBatch &b)
+        {
+            if (!b.state.prim.tme)
+                return false;
+            PagePlan own;
+            addToPlan(own, b);
+            own.hasTarget = false; // test the texture footprint only
+            return needsJoin(own, b) != 0;
+        }
+
+        void startHelpers()
+        {
+            const uint32_t n = workerCount();
+            m_textureCaches = std::make_unique<GSMem::TexturePageCache[]>(n);
+            // The helpers must start from the generation before any job is
+            // posted, or a job posted before a helper first runs is missed.
+            const uint64_t initialGeneration = m_jobGeneration.load(std::memory_order_acquire);
+            for (uint32_t k = 1; k < n; ++k)
+                m_helpers.emplace_back([this, k, n, initialGeneration] { helperLoop(k, n, initialGeneration); });
+        }
+
+        void stopHelpers()
+        {
+            m_helpersStop.store(true, std::memory_order_release);
+            m_jobGeneration.fetch_add(1u, std::memory_order_acq_rel);
+            m_jobGeneration.notify_all();
+            for (std::thread &t : m_helpers)
+                if (t.joinable())
+                    t.join();
+            m_helpers.clear();
+        }
+
+        void drawJob(uint32_t k, uint32_t n)
+        {
+            for (const RunDraw &d : m_run)
+                m_cpu->DrawRowsUnlocked(*d.batch, k, n, &m_textureCaches[k], m_runCluts[d.clut].data());
+        }
+
+        void helperLoop(uint32_t k, uint32_t n, uint64_t seen)
+        {
+            ps2x_prof::registerCurrentThread("gshelper");
+            for (;;)
+            {
+                uint64_t gen = m_jobGeneration.load(std::memory_order_acquire);
+                for (int spin = 0; gen == seen && spin < 20000; ++spin)
+                {
+                    _mm_pause();
+                    gen = m_jobGeneration.load(std::memory_order_acquire);
+                }
+                while (gen == seen)
+                {
+                    m_jobGeneration.wait(seen, std::memory_order_acquire);
+                    gen = m_jobGeneration.load(std::memory_order_acquire);
+                }
+                seen = gen;
+                if (m_helpersStop.load(std::memory_order_acquire))
+                    return;
+                try
+                {
+                    drawJob(k, n);
+                }
+                catch (...)
+                {
+                }
+                if (m_jobRemaining.fetch_sub(1u, std::memory_order_acq_rel) == 1u)
+                    m_jobRemaining.notify_one();
+            }
+        }
+
+        // Draws m_run on all threads; returns when every thread has finished.
+        void flushRun()
+        {
+            if (m_run.empty())
+                return;
+            const uint32_t n = workerCount();
+            {
+                std::lock_guard<std::mutex> rasterLock(m_cpu->RasterMutex());
+                for (uint32_t k = 0; k < n; ++k)
+                    m_textureCaches[k].Invalidate();
+                if (n > 1u)
+                {
+                    m_jobRemaining.store(n - 1u, std::memory_order_release);
+                    m_jobGeneration.fetch_add(1u, std::memory_order_acq_rel);
+                    m_jobGeneration.notify_all();
+                }
+                try
+                {
+                    drawJob(0u, n);
+                }
+                catch (...)
+                {
+                }
+                if (n > 1u)
+                {
+                    uint32_t left = m_jobRemaining.load(std::memory_order_acquire);
+                    for (int spin = 0; left != 0u && spin < 200000; ++spin)
+                    {
+                        _mm_pause();
+                        left = m_jobRemaining.load(std::memory_order_acquire);
+                    }
+                    while (left != 0u)
+                    {
+                        m_jobRemaining.wait(left, std::memory_order_acquire);
+                        left = m_jobRemaining.load(std::memory_order_acquire);
+                    }
+                }
+            }
+            ++m_stats.runs;
+            m_run.clear();
+            m_runCluts.clear();
+            m_plan = {};
+        }
+
+        // PS2X_GS_PARSTATS=1: every ~10 s, how draws were split.
+        struct ParStats
+        {
+            uint64_t runs = 0, parallelDraws = 0, serialOwnTarget = 0;
+            uint64_t joinTarget = 0, joinTexture = 0, joinCommand = 0, joinFull = 0;
+            uint64_t joinByKind[8]{};
+        };
+        ParStats m_stats;
+        std::chrono::steady_clock::time_point m_statsLast = std::chrono::steady_clock::now();
+
+        void maybePrintStats(bool force = false)
+        {
+            static const bool enabled = std::getenv("PS2X_GS_PARSTATS") != nullptr;
+            if (!enabled)
+                return;
+            const auto now = std::chrono::steady_clock::now();
+            if (!force && now - m_statsLast < std::chrono::seconds(10))
+                return;
+            m_statsLast = now;
+            std::cerr << "[gs:par] workers=" << workerCount()
+                      << " runs=" << m_stats.runs
+                      << " parallelDraws=" << m_stats.parallelDraws
+                      << " serialOwnTarget=" << m_stats.serialOwnTarget
+                      << " joins: target=" << m_stats.joinTarget
+                      << " texture=" << m_stats.joinTexture
+                      << " command=" << m_stats.joinCommand
+                      << " full=" << m_stats.joinFull
+                      << " byKind(clut,xfer,upload,texflush,writevram,vsync)="
+                      << m_stats.joinByKind[1] << "," << m_stats.joinByKind[2] << "," << m_stats.joinByKind[3] << ","
+                      << m_stats.joinByKind[4] << "," << m_stats.joinByKind[5] << "," << m_stats.joinByKind[6] << std::endl;
+            m_stats = {};
+        }
+
+        void workerLoop()
+        {
+            ps2x_prof::registerCurrentThread("gs");
+            const bool parallel = m_cpu != nullptr && workerCount() > 1u;
+            if (parallel)
+                startHelpers();
+            std::deque<Command> batch;
+            for (;;)
+            {
+                {
+                    std::unique_lock<std::mutex> lock(m_mutex);
+                    m_workCv.wait(lock, [this] { return m_stop || !m_queue.empty(); });
+                    if (m_queue.empty() && m_stop)
+                        break;
+                    batch.swap(m_queue);
+                }
+                m_spaceCv.notify_all();
+                uint64_t executed = 0;
+                for (Command &c : batch)
+                {
+                    try
+                    {
+                        if (parallel && c.kind == Kind::Submit)
+                        {
+                            if (c.batch.vertexCount != 0u)
+                            {
+                                if (samplesOwnTarget(c.batch))
+                                {
+                                    flushRun();
+                                    ++m_stats.serialOwnTarget;
+                                    if (std::getenv("PS2X_GS_PARDEBUG") && m_stats.serialOwnTarget <= 20u)
+                                    {
+                                        const auto &cx = c.batch.state.context;
+                                        std::cerr << "[gs:par-serial] fbp=" << cx.frame.fbp << " fbw=" << cx.frame.fbw << " fpsm=" << static_cast<int>(cx.frame.psm)
+                                                  << " zbp=" << cx.zbuf.zbp << " zpsm=" << static_cast<int>(cx.zbuf.psm) << " zmsk=" << cx.zbuf.zmask
+                                                  << " ztst=" << ((cx.test >> 17) & 3u) << " y1=" << cx.scissor.y1
+                                                  << " tbp0=" << cx.tex0.tbp0 << " tbw=" << static_cast<int>(cx.tex0.tbw) << " tpsm=" << static_cast<int>(cx.tex0.psm)
+                                                  << " tw=" << static_cast<int>(cx.tex0.tw) << " th=" << static_cast<int>(cx.tex0.th)
+                                                  << " clamp=0x" << std::hex << cx.clamp << std::dec << std::endl;
+                                    }
+                                    m_inner->Submit(c.batch); // single-threaded, as before
+                                }
+                                else
+                                {
+                                    const int reason = m_run.empty() ? 0 : needsJoin(m_plan, c.batch);
+                                    if (m_run.size() >= 256u || reason != 0)
+                                    {
+                                        if (reason == 1) ++m_stats.joinTarget;
+                                        else if (reason == 2) ++m_stats.joinTexture;
+                                        else ++m_stats.joinFull;
+                                        flushRun();
+                                    }
+                                    if (m_run.empty())
+                                    {
+                                        m_runCluts.resize(1);
+                                        m_cpu->CopyClutUnlocked(m_runCluts[0]);
+                                    }
+                                    addToPlan(m_plan, c.batch);
+                                    m_run.push_back({&c.batch, static_cast<uint32_t>(m_runCluts.size() - 1u)});
+                                    ++m_stats.parallelDraws;
+                                }
+                            }
+                        }
+                        else if (parallel && c.kind == Kind::LoadClut && !m_run.empty() && !clutSourceDirty(m_plan, c))
+                        {
+                            // CLUT load inside a run: the source was not drawn
+                            // to in this run, so loading it now reads the same
+                            // VRAM as after the run. Earlier draws keep their
+                            // CLUT snapshot; later ones get the new one.
+                            execute(c);
