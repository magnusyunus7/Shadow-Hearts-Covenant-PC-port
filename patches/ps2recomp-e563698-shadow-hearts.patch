+// ---------------------------------------------------------------------------
+// Host-side memory watchpoint (Windows only, opt-in, diagnostic).
+// PS2X_WATCH=<guest phys hex>,<length hex>: makes the host page(s) holding that
+// guest RAM range read-only. Every write to the page is caught; writes that hit
+// the watched range are logged with the writing instruction (exe offset, resolve
+// with the .map file). The write is then single-stepped and the page re-protected.
+// Output goes to PS2X_WATCH_LOG (default ps2x_watch.txt).
+namespace ps2x_watch
+{
+    namespace
+    {
+        uintptr_t g_pageBase = 0;
+        size_t g_pageLen = 0;
+        uintptr_t g_watchLo = 0;
+        uintptr_t g_watchHi = 0;
+        uintptr_t g_rdram = 0;
+        uintptr_t g_exeBase = 0;
+        FILE *g_log = nullptr;
+        thread_local bool t_rearm = false;
+        volatile LONG g_logged = 0;
+        constexpr int kMaxRips = 4096;
+        uint64_t g_rips[kMaxRips] = {};
+        uint32_t g_ripCounts[kMaxRips] = {};
+        thread_local uintptr_t t_pendingAddr = 0;
+
+        // First return addresses inside the exe (the writer's callers), for the log.
+        int callerFrames(CONTEXT ctx, uint64_t *out, int maxOut)
+        {
+            int n = 0;
+#if defined(_M_X64)
+            __try
+            {
+                for (int i = 0; i < 32 && n < maxOut; ++i)
+                {
+                    DWORD64 imageBase = 0;
+                    PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(ctx.Rip, &imageBase, nullptr);
+                    if (fn == nullptr)
+                    {
+                        ctx.Rip = *reinterpret_cast<const DWORD64 *>(ctx.Rsp);
+                        ctx.Rsp += 8;
+                    }
+                    else
+                    {
+                        PVOID hd = nullptr;
+                        DWORD64 ef = 0;
+                        RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, ctx.Rip, fn, &ctx, &hd, &ef, nullptr);
+                    }
+                    if (ctx.Rip == 0)
+                        break;
+                    if (ctx.Rip >= g_exeBase && ctx.Rip < g_exeBase + 0x40000000ull)
+                        out[n++] = ctx.Rip - g_exeBase;
+                }
+            }
+            __except (EXCEPTION_EXECUTE_HANDLER)
+            {
+            }
+#endif
+            return n;
+        }
+
+        LONG CALLBACK handler(EXCEPTION_POINTERS *info)
+        {
+            const DWORD code = info->ExceptionRecord->ExceptionCode;
+            if (code == EXCEPTION_ACCESS_VIOLATION && info->ExceptionRecord->NumberParameters >= 2 &&
+                info->ExceptionRecord->ExceptionInformation[0] == 1)
+            {
+                const uintptr_t addr = static_cast<uintptr_t>(info->ExceptionRecord->ExceptionInformation[1]);
+                if (addr < g_pageBase || addr >= g_pageBase + g_pageLen)
+                    return EXCEPTION_CONTINUE_SEARCH;
+#if defined(_M_X64)
+                const uint64_t rip = info->ContextRecord->Rip;
+#else
+                const uint64_t rip = info->ContextRecord->Eip;
+#endif
+                // Log at most 4 writes per distinct writing instruction, so one busy writer
+                // (e.g. the movie decoder filling a buffer) cannot use up the log.
+                bool logThis = false;
+                uint64_t callers[3] = {0, 0, 0};
+                int ncallers = 0;
+                uint64_t key = rip;
+                if (addr >= g_watchLo && addr < g_watchHi && g_log)
+                {
+                    ncallers = callerFrames(*info->ContextRecord, callers, 3);
+                    key = rip ^ (callers[0] * 0x9E3779B97F4A7C15ull) ^ (callers[1] * 0xC2B2AE3D27D4EB4Full);
+                    for (int k = 0; k < kMaxRips; ++k)
+                    {
+                        if (g_rips[k] == key)
+                        {
+                            logThis = ++g_ripCounts[k] <= 4u;
+                            break;
+                        }
+                        if (g_rips[k] == 0)
+                        {
+                            g_rips[k] = key;
+                            g_ripCounts[k] = 1u;
+                            logThis = true;
+                            break;
+                        }
+                    }
+                }
+                if (logThis && InterlockedIncrement(&g_logged) <= 20000)
+                {
+                    std::fprintf(g_log, "write guest=%08llx rip=exe+0x%llx thread=%lu tick=%llu callers=exe+0x%llx,exe+0x%llx,exe+0x%llx",
+                                 static_cast<unsigned long long>(addr - g_rdram),
+                                 static_cast<unsigned long long>(rip - g_exeBase), GetCurrentThreadId(),
+                                 static_cast<unsigned long long>(GetTickCount64()),
+                                 static_cast<unsigned long long>(callers[0]), static_cast<unsigned long long>(callers[1]),
+                                 static_cast<unsigned long long>(callers[2]));
+                    t_pendingAddr = addr; // value is logged after the write completes (single-step)
+                }
+                DWORD old = 0;
+                VirtualProtect(reinterpret_cast<void *>(g_pageBase), g_pageLen, PAGE_READWRITE, &old);
+                info->ContextRecord->EFlags |= 0x100u; // trap flag: re-protect after this instruction
+                t_rearm = true;
+                return EXCEPTION_CONTINUE_EXECUTION;
+            }
+            if (code == EXCEPTION_SINGLE_STEP && t_rearm)
+            {
+                t_rearm = false;
+                if (t_pendingAddr && g_log)
+                {
+                    const uintptr_t a = t_pendingAddr & ~static_cast<uintptr_t>(15);
+                    uint32_t v[4] = {};
+                    std::memcpy(v, reinterpret_cast<const void *>(a), sizeof(v));
+                    std::fprintf(g_log, " qword@%08llx=%08x %08x %08x %08x\n",
+                                 static_cast<unsigned long long>(a - g_rdram), v[0], v[1], v[2], v[3]);
+                    std::fflush(g_log);
+                    t_pendingAddr = 0;
+                }
+                DWORD old = 0;
+                VirtualProtect(reinterpret_cast<void *>(g_pageBase), g_pageLen, PAGE_READONLY, &old);
+                return EXCEPTION_CONTINUE_EXECUTION;
+            }
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+    }
+
+    // PS2X_WATCH watches guest RAM; PS2X_WATCH_VRAM=<byte offset hex>,<len hex> watches GS VRAM instead
+    // (offsets in the log are then VRAM byte offsets).
+    void arm(uint8_t *rdram, uint8_t *vram)
+    {
+        static bool armed = false;
+        const char *vramSpec = std::getenv("PS2X_WATCH_VRAM");
+        const bool useVram = vramSpec && *vramSpec && vram;
+        const char *spec = useVram ? vramSpec : std::getenv("PS2X_WATCH");
+        if (useVram)
+            rdram = vram;
+        if (armed || !spec || !*spec || !rdram)
+            return;
+        armed = true;
+        unsigned long long guest = 0, len = 0x40;
+        if (std::sscanf(spec, "%llx,%llx", &guest, &len) < 1 || len == 0)
+            return;
+        const char *logPath = std::getenv("PS2X_WATCH_LOG");
+        g_log = std::fopen(logPath && *logPath ? logPath : "ps2x_watch.txt", "w");
+        g_rdram = reinterpret_cast<uintptr_t>(rdram);
+        g_exeBase = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+        g_watchLo = g_rdram + guest;
+        g_watchHi = g_watchLo + len;
+        SYSTEM_INFO si{};
+        GetSystemInfo(&si);
+        const uintptr_t page = si.dwPageSize;
+        g_pageBase = g_watchLo & ~(page - 1);
+        g_pageLen = ((g_watchHi + page - 1) & ~(page - 1)) - g_pageBase;
+        if (g_log)
+        {
+            std::fprintf(g_log, "# watch guest %llx..%llx exeBase=0x%llx\n", guest, guest + len,
+                         static_cast<unsigned long long>(g_exeBase));
+            std::fflush(g_log);
+        }
+        AddVectoredExceptionHandler(1, handler);
+        DWORD old = 0;
+        VirtualProtect(reinterpret_cast<void *>(g_pageBase), g_pageLen, PAGE_READONLY, &old);
+    }
+}
+
+#else
+
+namespace ps2x_prof
+{
+    void registerCurrentThread(const char *) {}
+    void start(void *)
+    {
+    }
+}
+namespace ps2x_watch
+{
+    void arm(uint8_t *, uint8_t *)
+    {
+    }
+}
+
+#endif
