+        uint8_t sector[kCdSectorSize];
+        if (!readSector(16u, sector) || sector[0] != 1u || std::memcmp(sector + 1, "CD001", 5) != 0)
+            return false;
+        uint32_t dirLsn = le32(sector + 156 + 2);
+        uint32_t dirSize = le32(sector + 156 + 10);
+
+        std::string rel = normalizeCdPathNoPrefix(ps2Path);
+        std::vector<std::string> parts;
+        for (size_t start = 0; start <= rel.size();)
+        {
+            size_t end = rel.find_first_of("/\\", start);
+            if (end == std::string::npos)
