+// Bytes of `d` made of complete GIF packets. An incomplete PACKED/REGLIST tag ends the count at
+// its own start; an incomplete IMAGE tag counts as complete (its data streams).
+static uint32_t completeGifBytes(const uint8_t *d, uint32_t n)
+{
+    uint32_t off = 0u;
+    while (off + 16u <= n)
+    {
