+// Shadow Hearts: Covenant (USA, SLUS_210.41) runtime overrides.
+//
+// Included from game_overrides.cpp so the registration object is linked (a separate translation
+// unit in the static runtime library would be dropped by the linker as unreferenced).
+
+namespace shc_usa
+{
+    // sceCdLayerSearchFile(sceCdlFILE *fp, const char *name, int layer) at 0x215860 has no runtime
+    // handler, so the game's own libcdvd code runs, binds the cdvdfsv RPC server 0x80000597 and
+    // retries forever because the runtime has no cdvdfsv RPC service. The game uses it to locate
+    // its .PKB packages. The first two arguments match sceCdSearchFile(fp, name); this is a single
+    // layer disc, so the layer argument can be ignored.
+    constexpr uint32_t kSceCdLayerSearchFile = 0x00215860u;
+
+    void apply(PS2Runtime &runtime)
+    {
+        if (!ps2_game_overrides::bindAddressHandler(runtime, kSceCdLayerSearchFile, "sceCdSearchFile"))
+            std::cerr << "[shc] failed to bind sceCdLayerSearchFile override" << std::endl;
+    }
+}
+
+PS2_REGISTER_GAME_OVERRIDE("Shadow Hearts: Covenant (USA)", "SLUS_210.41", 0x00200008u, 0u, &shc_usa::apply)
