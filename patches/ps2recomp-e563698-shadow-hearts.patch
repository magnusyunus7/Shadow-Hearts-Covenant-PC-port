new file mode 100644
index 0000000000000000000000000000000000000000..82ebe9f9146b498da37d91437c165dd8a1e78479
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_overlay_banks.h
@@ -0,0 +1,54 @@
+#pragma once
+
+// Overlay function banks.
+//
+// Some games load different code overlays at the same guest address (Shadow Hearts: Covenant loads
+// FIELD.BIN, BATTLE.BIN and OPENING.BIN, all at 0x45EA80). Each overlay is recompiled separately
+// into its own C++ namespace and registers a "bank": a dense function table for its address range
+// plus a way to recognise, from guest memory, whether that overlay is the one currently loaded.
+//
+// When the main function table has no entry for an address, the runtime asks the banks. A bank
+// matches when the 32-bit words at `signatureAddr` and `signatureAddr + 4` in guest RAM equal
+// `signature0` / `signature1` (for Metrowerks overlays: the "MWo3" magic and the overlay id in the
+// header that is loaded together with the code). A bank with signatureAddr == 0 is always active
+// and only answers for addresses it has a function for (used for extra main-executable entries).
+
+#include <cstdint>
+#include "ps2_runtime.h"
+
+namespace ps2x_overlay
+{
+    struct Bank
+    {
+        const char *name = nullptr;
+        uint32_t signatureAddr = 0;
+        uint32_t signature0 = 0;
+        uint32_t signature1 = 0;
+        uint32_t tableBase = 0;  // guest address of slot 0
+        uint32_t slotCount = 0;  // one slot per 4 bytes
+        const PS2Runtime::RecompiledFunction *table = nullptr;
+    };
+
+    // Called from static initialisers in the generated overlay registration files.
+    void registerBank(const Bank &bank);
+
+    // Returns the recompiled function for `address` in the overlay currently loaded, or nullptr.
+    PS2Runtime::RecompiledFunction find(const uint8_t *rdram, uint32_t address);
+
+    // Name of the bank currently loaded at `address`, or nullptr (diagnostics).
+    const char *loadedBankName(const uint8_t *rdram, uint32_t address);
+
+    // A dense table filled at start-up from run-length records, so the generated registration
+    // file stays small: each run maps `count` consecutive slots starting at `firstSlot` to
+    // functions[functionIndex].
+    struct Run
+    {
+        uint32_t firstSlot;
+        uint32_t count;
+        uint32_t functionIndex;
+    };
+
+    void buildTable(PS2Runtime::RecompiledFunction *table, uint32_t slotCount,
+                    const PS2Runtime::RecompiledFunction *functions,
+                    const Run *runs, uint32_t runCount);
+}
