+    // Look a path up in the configured disc image's ISO9660 directory tree and return its real
+    // extent. Using real LSNs keeps the EE side consistent with IOP modules (e.g. a game's own
+    // file driver) that read the same sectors through cdvdman from the image.
+    bool findInCdImage(const std::filesystem::path &image, const std::string &ps2Path, uint32_t &lsnOut, uint32_t &sizeOut)
+    {
+        std::ifstream iso(image, std::ios::binary);
+        if (!iso.is_open())
+            return false;
+        auto readSector = [&](uint32_t lsn, uint8_t *dst) -> bool
+        {
+            iso.clear();
+            iso.seekg(static_cast<std::streamoff>(lsn) * kCdSectorSize, std::ios::beg);
+            iso.read(reinterpret_cast<char *>(dst), kCdSectorSize);
+            return iso.gcount() == static_cast<std::streamsize>(kCdSectorSize);
+        };
+        auto le32 = [](const uint8_t *p) -> uint32_t
+        { return static_cast<uint32_t>(p[0]) | (static_cast<uint32_t>(p[1]) << 8) | (static_cast<uint32_t>(p[2]) << 16) | (static_cast<uint32_t>(p[3]) << 24); };
+
+        uint8_t sector[kCdSectorSize];
+        if (!readSector(16u, sector) || sector[0] != 1u || std::memcmp(sector + 1, "CD001", 5) != 0)
+            return false;
+        uint32_t dirLsn = le32(sector + 156 + 2);
+        uint32_t dirSize = le32(sector + 156 + 10);
