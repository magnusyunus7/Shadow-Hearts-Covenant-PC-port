+            d.last = now;
+            ++d.summaries;
+            std::fprintf(stderr, "[spu2:summary] %llu writes so far; busiest offsets:", static_cast<unsigned long long>(d.total));
+            std::array<uint32_t, 0x800 / 2> idx{};
+            for (uint32_t i = 0; i < idx.size(); ++i)
+                idx[i] = i;
+            std::partial_sort(idx.begin(), idx.begin() + 24, idx.end(), [&](uint32_t a, uint32_t b)
+                              { return d.counts[a] > d.counts[b]; });
+            for (uint32_t k = 0; k < 24u && d.counts[idx[k]] != 0u; ++k)
+                std::fprintf(stderr, " %03x:%u", idx[k] * 2u, d.counts[idx[k]]);
+            std::fprintf(stderr, "\n");
+        }
+    }
+}
