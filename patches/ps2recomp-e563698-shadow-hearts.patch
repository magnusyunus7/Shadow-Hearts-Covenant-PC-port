diff --git a/ps2xRuntime/src/lib/Kernel/HostProfiler.cpp b/ps2xRuntime/src/lib/Kernel/HostProfiler.cpp
new file mode 100755
index 0000000..42ebd89
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/HostProfiler.cpp
@@ -0,0 +1,442 @@
+// Host-side sampling profiler (Windows only, opt-in).
+//
+// Set PS2X_PROFILE=<output file> before starting the runner. A background thread
+// then samples the instruction pointer of the game thread (and the main/render
+// thread) about every millisecond, walks its stack, and appends a histogram to <output file> every
+// 10 seconds. Offsets are relative to the runner executable's load address, so
+// they can be resolved with the linker map file (ps2EntryRunner.map).
+//
+// Diagnostic only: has no effect unless PS2X_PROFILE is set.
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstdio>
+
+#if defined(_WIN32)
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace ps2x_prof
+{
+    namespace
+    {
+        struct Sampled
+        {
+            HANDLE handle = nullptr;
+            const char *name = "";
+            std::unordered_map<std::string, uint32_t> hist;
+            uint64_t total = 0;
+            uint64_t failed = 0;
+        };
+
+        void describeAddress(uint64_t addr, uintptr_t exeBase, char *out, size_t outSize)
+        {
+            HMODULE mod = nullptr;
+            if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                   reinterpret_cast<LPCSTR>(addr), &mod) &&
+                mod != nullptr)
+            {
+                const uintptr_t modBase = reinterpret_cast<uintptr_t>(mod);
+                if (modBase == exeBase)
+                {
+                    std::snprintf(out, outSize, "exe+0x%llx", static_cast<unsigned long long>(addr - exeBase));
+                    return;
+                }
+                char path[MAX_PATH] = {};
+                GetModuleFileNameA(mod, path, MAX_PATH);
+                const char *file = path;
+                for (const char *p = path; *p; ++p)
+                {
+                    if (*p == '\\' || *p == '/')
+                    {
+                        file = p + 1;
+                    }
+                }
+                std::snprintf(out, outSize, "%s+0x%llx", file, static_cast<unsigned long long>(addr - modBase));
+                return;
+            }
+            std::snprintf(out, outSize, "abs:0x%llx", static_cast<unsigned long long>(addr));
+        }
+
+        // Walks the suspended thread's stack and stores up to maxFrames return
+        // addresses (frame 0 = current instruction). Returns the frame count.
+        int unwindStack(CONTEXT ctx, uint64_t *frames, int maxFrames)
+        {
+            int n = 0;
+#if defined(_M_X64)
+            __try
+            {
+                for (int i = 0; i < 64 && n < maxFrames; ++i)
+                {
+                    if (ctx.Rip == 0)
+                    {
+                        break;
+                    }
+                    frames[n++] = ctx.Rip;
+                    DWORD64 imageBase = 0;
+                    PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(ctx.Rip, &imageBase, nullptr);
+                    if (fn == nullptr)
+                    {
+                        // Leaf function: return address is at [rsp].
+                        ctx.Rip = *reinterpret_cast<const DWORD64 *>(ctx.Rsp);
+                        ctx.Rsp += 8;
+                    }
+                    else
+                    {
+                        PVOID handlerData = nullptr;
+                        DWORD64 establisher = 0;
+                        RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, ctx.Rip, fn, &ctx, &handlerData,
+                                         &establisher, nullptr);
+                    }
+                }
+            }
+            __except (EXCEPTION_EXECUTE_HANDLER)
+            {
+            }
+#else
+            frames[n++] = ctx.Eip;
+#endif
+            return n;
+        }
+    }
+
+    void start(void *gameThreadNativeHandle)
+    {
+        const char *outPath = std::getenv("PS2X_PROFILE");
+        if (outPath == nullptr || *outPath == '\0' || gameThreadNativeHandle == nullptr)
+        {
+            return;
+        }
+
+        const DWORD access = THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION;
+        HANDLE gameHandle = nullptr;
+        HANDLE mainHandle = nullptr;
+        DuplicateHandle(GetCurrentProcess(), static_cast<HANDLE>(gameThreadNativeHandle), GetCurrentProcess(),
+                        &gameHandle, access, FALSE, 0);
+        DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &mainHandle, access, FALSE, 0);
+        if (gameHandle == nullptr)
+        {
+            return;
+        }
+
+        const std::string path(outPath);
+        const uintptr_t exeBase = reinterpret_cast<uintptr_t>(GetModuleHandleW(nullptr));
+
+        std::thread([path, exeBase, gameHandle, mainHandle]()
+                    {
+            std::vector<Sampled> threads(2);
+            threads[0].handle = gameHandle;
+            threads[0].name = "game";
+            threads[1].handle = mainHandle;
+            threads[1].name = "main";
+
+            if (FILE *f = std::fopen(path.c_str(), "w"))
+            {
+                std::fprintf(f, "# ps2x host profile, exeBase=0x%llx, interval=10s\n",
+                             static_cast<unsigned long long>(exeBase));
+                std::fclose(f);
+            }
+
+            uint32_t interval = 0;
+            ULONGLONG last = GetTickCount64();
+            for (;;)
+            {
+                for (Sampled &t : threads)
+                {
+                    if (t.handle == nullptr)
+                    {
+                        continue;
+                    }
+                    if (SuspendThread(t.handle) == static_cast<DWORD>(-1))
+                    {
+                        ++t.failed;
+                        continue;
+                    }
+                    CONTEXT ctx{};
+                    ctx.ContextFlags = CONTEXT_FULL;
+                    const BOOL ok = GetThreadContext(t.handle, &ctx);
+                    uint64_t frames[48];
+                    int nframes = 0;
+                    if (ok)
+                    {
+                        nframes = unwindStack(ctx, frames, 48);
+                    }
+                    ResumeThread(t.handle);
+                    if (!ok || nframes == 0)
+                    {
+                        ++t.failed;
+                        continue;
+                    }
+                    // Key: the leaf location, then the first 6 frames inside the exe.
+                    char where[MAX_PATH + 64];
+                    describeAddress(frames[0], exeBase, where, sizeof(where));
+                    std::string key(where);
+                    key += " |";
+                    int exeFrames = 0;
+                    for (int i = 0; i < nframes && exeFrames < 6; ++i)
+                    {
+                        HMODULE mod = nullptr;
+                        if (GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                                   GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                               reinterpret_cast<LPCSTR>(frames[i]), &mod) &&
+                            reinterpret_cast<uintptr_t>(mod) == exeBase)
+                        {
+                            char buf[32];
+                            std::snprintf(buf, sizeof(buf), " exe+0x%llx",
+                                          static_cast<unsigned long long>(frames[i] - exeBase));
+                            key += buf;
+                            ++exeFrames;
+                        }
+                    }
+                    ++t.hist[key];
+                    ++t.total;
+                }
+
+                Sleep(1);
+
+                const ULONGLONG now = GetTickCount64();
+                if (now - last < 10000)
+                {
+                    continue;
+                }
+                last = now;
+                ++interval;
+
+                if (FILE *f = std::fopen(path.c_str(), "a"))
+                {
+                    for (Sampled &t : threads)
+                    {
+                        std::fprintf(f, "== interval %u thread=%s samples=%llu failed=%llu\n", interval, t.name,
+                                     static_cast<unsigned long long>(t.total),
+                                     static_cast<unsigned long long>(t.failed));
+                        std::vector<std::pair<std::string, uint32_t>> entries(t.hist.begin(), t.hist.end());
+                        std::sort(entries.begin(), entries.end(),
+                                  [](const auto &a, const auto &b) { return a.second > b.second; });
+                        size_t shown = 0;
+                        for (const auto &e : entries)
+                        {
+                            if (++shown > 60)
+                            {
+                                break;
+                            }
+                            std::fprintf(f, "%u %s\n", e.second, e.first.c_str());
+                        }
+                        t.hist.clear();
+                        t.total = 0;
+                        t.failed = 0;
+                    }
+                    std::fclose(f);
+                }
+            } })
+            .detach();
+    }
+}
