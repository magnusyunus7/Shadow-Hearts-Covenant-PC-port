+uint32_t g_ps2xFrameNo = 0u; // display flips so far (frame number in [frame] lines)
+
+namespace
+{
+    // Called on every display flip. PS2X_FRAMESTATS=1 prints one line per frame: primitives
+    // drawn, VIF1 bytes, VU1 programs run and XGKICKs. PS2X_AUTODUMP=1 (with PS2X_GSDUMP) takes
+    // the F9 snapshot automatically when a frame draws far fewer primitives than the recent
+    // average, which catches objects that vanish for only a few frames (at most 3 per run).
+    void ps2xFrameStats(PS2Runtime *runtime)
+    {
+        static const bool print = std::getenv("PS2X_FRAMESTATS") != nullptr;
+        static const bool autoDump = std::getenv("PS2X_AUTODUMP") != nullptr && std::getenv("PS2X_GSDUMP") != nullptr;
+        static uint32_t frame = 0u;
+        static uint32_t history[16] = {};
+        static uint32_t filled = 0u;
+        static uint32_t cooldown = 0u;
+        static uint32_t dumps = 0u;
+        static uint32_t lines = 0u;
+        const uint32_t prims = g_ps2xStatPrims;
+        const uint32_t vifBytes = g_ps2xStatVif1Bytes;
+        const uint32_t runs = g_ps2xStatVu1Runs;
+        const uint32_t kicks = g_ps2xStatXgkicks;
+        g_ps2xStatPrims = g_ps2xStatVif1Bytes = g_ps2xStatVu1Runs = g_ps2xStatXgkicks = 0u;
+        ++frame;
+        g_ps2xFrameNo = frame;
+        {
+            // The GS may draw on its own thread (PS2X_GS_THREAD): let it catch
+            // up before the GIF history copies VRAM as this frame's start state.
+            static const bool gsDump = std::getenv("PS2X_GSDUMP") != nullptr;
+            if (gsDump)
+                (void)runtime->gs().ReadVram(0u, 0u, 1u, 0u, 0u);
+        }
+        ps2x_gifHistoryFlip(runtime->memory().getGSVRAM(), PS2_GS_VRAM_SIZE);
+
+        uint64_t sum = 0u;
+        for (uint32_t k = 0; k < filled; ++k)
+            sum += history[k];
+        const uint32_t avg = filled ? static_cast<uint32_t>(sum / filled) : 0u;
+        const bool drop = filled == 16u && avg >= 1500u && static_cast<uint64_t>(prims) * 4u < static_cast<uint64_t>(avg) * 3u;
+
+        if (print && lines < 50000u)
+        {
+            ++lines;
+            std::fprintf(stderr, "[frame] n=%u vsync=%llu prims=%u avg=%u vif1=%u vu1runs=%u xgkicks=%u%s\n", frame,
+                         static_cast<unsigned long long>(runtime->eeScheduler().currentVSyncTick()), prims, avg, vifBytes,
+                         runs, kicks, drop ? " DROP" : "");
+        }
+        if (autoDump && drop && cooldown == 0u && dumps < 3u)
+        {
+            ++dumps;
+            cooldown = 120u;
+            g_ps2xAutoDumpRequest.store(true, std::memory_order_release);
+            std::fprintf(stderr, "[frame] automatic snapshot %u at frame %u (prims %u, average %u)\n", dumps, frame, prims, avg);
+        }
+        if (cooldown)
+            --cooldown;
+        if (!drop)
+        {
+            // Only normal frames feed the average, so a run of short frames keeps triggering.
+            history[filled < 16u ? filled : (frame % 16u)] = prims;
+            if (filled < 16u)
+                ++filled;
+        }
+    }
