+// on real hardware; without this the rest of the payload was parsed as VIF codes (a GIF
+// packet fragment once decoded as "UNPACK S-16 x177 to row 0" and wiped the VU1 matrices).
+static std::vector<uint8_t> s_vif1Carry;
+
+// PATH2 GIF packets can be split across DIRECT commands (e.g. the GIF tag in one DIRECT, its
+// data in the next); the GIF keeps parsing across them on hardware. The GS parser here starts
+// fresh on every submission, so an unfinished PACKED/REGLIST tag is held back and resubmitted
+// with the following DIRECT payload. (IMAGE tags already stream: see m_vif1PendingPath2ImageQwc.)
+static std::vector<uint8_t> s_path2GifCarry;
