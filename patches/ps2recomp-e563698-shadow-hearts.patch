+    void IopRpcBridge::writeGuestCmdEntry(uint32_t cid, uint32_t function, uint32_t data)
+    {
+        const bool isSystem = (cid & 0x80000000u) != 0u;
+        const uint32_t index = cid & 0x7FFFFFFFu;
+        const uint32_t table = isSystem ? m_sysCmdTable : m_userCmdTable;
+        const uint32_t size = isSystem ? m_sysCmdTableSize : m_userCmdTableSize;
+        if (table == 0u || index >= size || !m_memory.ownsRamRange(table + index * 8u, 8u))
+            return;
+        m_memory.write32(table + index * 8u, function);
+        m_memory.write32(table + index * 8u + 4u, data);
+    }
+
+    bool IopRpcBridge::deliverEeCommand(uint32_t commandId,
+                                        const void *packet,
+                                        size_t packetSize,
+                                        IopGuestExecutor &executor)
+    {
+        constexpr size_t kHeaderSize = 16u;
+        constexpr size_t kMaxPacketSize = 128u;
+        if (!packet || packetSize < kHeaderSize || packetSize > kMaxPacketSize)
+            return false;
+
+        // Prefer the guest table when one is set: that is where real sifcmd looks.
+        {
+            const bool isSystem = (commandId & 0x80000000u) != 0u;
+            const uint32_t index = commandId & 0x7FFFFFFFu;
+            const uint32_t table = isSystem ? m_sysCmdTable : m_userCmdTable;
+            const uint32_t size = isSystem ? m_sysCmdTableSize : m_userCmdTableSize;
+            if (table != 0u && index < size && m_memory.ownsRamRange(table + index * 8u, 8u))
+            {
+                const uint32_t fn = m_memory.read32(table + index * 8u);
+                const uint32_t data = m_memory.read32(table + index * 8u + 4u);
+                if (fn != 0u)
+                {
+                    auto known = m_cmdHandlers.find(commandId);
+                    CmdHandler h;
+                    h.function = fn;
+                    h.data = data;
+                    h.gp = (known != m_cmdHandlers.end() && known->second.function == fn) ? known->second.gp : 0u;
+                    m_cmdHandlers[commandId] = h;
+                }
+            }
+        }
+        // Real sifcmd keys user commands by the low bits; system commands keep bit 31.
+        auto handlerIt = m_cmdHandlers.find(commandId);
+        if (handlerIt == m_cmdHandlers.end())
+            handlerIt = m_cmdHandlers.find(commandId & 0x7FFFFFFFu);
+        if (handlerIt == m_cmdHandlers.end() || handlerIt->second.function == 0u)
+        {
+            ps2x::iop::sifDiag("EE->IOP cmd cid=0x%x: no IOP handler (registered: %zu)", commandId, m_cmdHandlers.size());
+            return false;
+        }
+
+        // sifcmd receives packets into its own buffer; emulate that with one IOP allocation.
+        if (m_cmdPacketBuffer == 0u)
+            m_cmdPacketBuffer = m_memory.allocate(static_cast<uint32_t>(kMaxPacketSize), 16u);
+        if (m_cmdPacketBuffer == 0u || !m_memory.writeRam(m_cmdPacketBuffer, packet, packetSize))
+            return false;
+
+        const CmdHandler handler = handlerIt->second;
+        {
+            uint32_t w3 = 0;
+            std::memcpy(&w3, static_cast<const uint8_t *>(packet) + 12u, sizeof(w3));
+            ps2x::iop::sifDiag("EE->IOP cmd cid=0x%x -> IOP handler 0x%x (packet @0x%x, word3=0x%x)", commandId, handler.function, m_cmdPacketBuffer, w3);
+            sifDiagHex("EE->IOP", static_cast<const uint8_t *>(packet), packetSize);
+        }
+        (void)executor.executeGuestFunction(handler.function,
+                                            m_cmdPacketBuffer,
+                                            handler.data,
+                                            0u,
+                                            0u,
+                                            handler.gp);
+        return true;
+    }
